<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- Password policies -->
        <limit-password />
        <watch-login />
        <reset-password />
        <force-lock />

        <!-- Device control -->
        <wipe-data />
        <expire-password />
        <encrypted-storage />
        <disable-camera />

        <!-- Additional policies for Device Owner -->
        <disable-keyguard-features />
    </uses-policies>
</device-admin>